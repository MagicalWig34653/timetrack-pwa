{
  "name": "timetrack-pwa",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "prepare": "svelte-kit sync || echo ''",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json && tsc -p tsconfig.service-worker.json --noEmit",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "dev:mock": "VITE_MOCK=1 vite dev",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "npm run build && playwright test",
    "test:e2e:mock": "playwright test -c playwright.mock.config.ts",
    "test:e2e:pwa": "npm run build && playwright test -c playwright.pwa.config.ts",
    "icons": "node scripts/generate-icons.mjs"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@lucide/svelte": "^1.56.0",
    "@playwright/test": "^1.64.0",
    "@sveltejs/adapter-static": "^4.0.0",
    "@sveltejs/kit": "^3.0.0",
    "@sveltejs/vite-plugin-svelte": "^7.2.0",
    "@tailwindcss/vite": "^4.3.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/svelte": "^5.4.2",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^26.6.5",
    "cn": "^0.4.0",
    "exceljs": "^4.4.0",
    "jsdom": "^30.1.2",
    "shadcn-svelte": "^1.7.0",
    "svelte": "^5.57.1",
    "svelte-check": "^4.6.0",
    "tailwind-variants": "^3.3.1",
    "tailwindcss": "^4.3.0",
    "tw-animate-css": "^1.4.0",
    "typescript": "^6.0.3",
    "vite": "^8.3.0",
    "vitest": "^5.0.4"
  },
  "imports": {
    "#lib": "./src/lib/index.js",
    "#lib/*": "./src/lib/*"
  },
  "license": "AGPL-3.0-only",
  "packageManager": "npm@11.17.0",
  "dependencies": {
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.4.299"
  }
}
